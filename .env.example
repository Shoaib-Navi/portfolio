# Canonical site URL for metadata, sitemap.xml and robots.txt.
# On Vercel this is detected automatically — set it only when self-hosting,
# or to pin a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Admin dashboard (/admin) ----
# Generate the hash and secret with:  npm run admin:hash -- "a long password"
ADMIN_USER=shoaib
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
SESSION_SECRET=at-least-32-random-characters

# With these two set, saves become commits to GitHub and publishing deploys through
# Vercel. Without them (local dev) the admin reads and writes files on disk.
# Token: fine-grained PAT, this repository only, permission "Contents: Read and write"
# (add "Commit statuses: Read" to show deploy status).
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=Shoaib-Navi/portfolio
# GITHUB_BRANCH=main
